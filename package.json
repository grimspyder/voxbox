{
  "name": "voxbox",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:native": "node scripts/build-native.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "android:sync": "npm run build:native && cap sync android",
    "android:debug": "npm run android:sync && node scripts/android-build.mjs assembleDebug",
    "android:bundle": "npm run android:sync && node scripts/android-build.mjs bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "next": "15.5.26",
    "openai": "^4.104.0",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.26",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
