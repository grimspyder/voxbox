<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Speed monitoring. exported=false: only this app can start it.
             stopWithTask=false so a swipe-away does not silently end a drive,
             but the plugin stops it explicitly when drive mode ends. -->
        <service
            android:name=".SpeedMonitorService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />
    </application>

    <!-- Permissions -->

    <!-- The only two permissions Vox needs (brief §69). The microphone is used
         exclusively while a conversation is active; there is no background
         listening, so no foreground service or background-audio permission is
         requested. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Not a stylistic addition: Capacitor's BridgeWebChromeClient requests
         MODIFY_AUDIO_SETTINGS and RECORD_AUDIO together when the WebView asks
         for audio capture, and denies the request unless both are granted
         (BridgeWebChromeClient.java, onPermissionRequest). Without this,
         getUserMedia is refused inside the WebView and the microphone appears
         broken. It is a normal permission: no runtime prompt, no user-visible
         capability. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Speed monitoring for traffic alerts. Foreground location service: the
         phone runs in a cradle with the screen off, so plain location updates
         would be frozen. The persistent notification is mandatory on Android 8+
         and is also the visible indicator that location is in use. Play requires
         a foreground-service declaration for the location type. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Devices without a microphone can still install Vox and talk by text. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Location is optional: without it the app works, traffic alerts do not. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
