<?xml version="1.0" encoding="utf-8"?>
<!--
  KITT stores user-supplied provider keys on the device. Nothing from the app's
  private storage is ever included in a cloud backup, so a key cannot be lifted
  off the device that way.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
